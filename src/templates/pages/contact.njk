{% extends "layouts/layout.njk" %}

{% set title = "Contact Us" %}
{% set activePage = "contact" %}

{% block content %}
<div class="container py-5">
    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold">Get in Touch</h1>
      <p class="fs-5 text-muted">We'd love to hear from you. Fill out the form below and we will get back to you shortly.</p>
    </div>
    
    <div class="row g-5 justify-content-center">
      <div class="col-md-8">
        <div class="card p-4">
            <form class="needs-validation" novalidate>
                <div class="row g-3">
                    <div class="col-12">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="you@example.com" required>
                    </div>
                    <div class="col-12">
                        <label for="message" class="form-label">Message</label>
                        <textarea class="form-control" id="message" rows="5" placeholder="Your message here..." required></textarea>
                    </div>
                </div>
                <hr class="my-4">
                <button class="w-100 btn btn-primary btn-lg" type="submit">Send Message</button>
            </form>
        </div>
      </div>
    </div>
</div>
{% endblock %}